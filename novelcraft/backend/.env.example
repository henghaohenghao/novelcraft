# NovelCraft V2.0 环境变量配置示例

# 数据库配置
NOVELCRAFT_DB_HOST=localhost
NOVELCRAFT_DB_PORT=5432
NOVELCRAFT_DB_USER=novelcraft
NOVELCRAFT_DB_PASSWORD=novelcraft123
NOVELCRAFT_DB_NAME=novelcraft
NOVELCRAFT_DB_DRIVER=postgresql

# Neo4j 图数据库
NOVELCRAFT_NEO4J_URI=bolt://localhost:7687
NOVELCRAFT_NEO4J_USER=neo4j
NOVELCRAFT_NEO4J_PASSWORD=12345678

# Qdrant 向量数据库
NOVELCRAFT_QDRANT_HOST=localhost
NOVELCRAFT_QDRANT_PORT=6333
NOVELCRAFT_QDRANT_API_KEY=

# Redis (V2.0 新增 - 用于协同编辑和缓存)
NOVELCRAFT_REDIS_URL=redis://localhost:6379/0

# Celery
NOVELCRAFT_CELERY_BROKER_URL=redis://localhost:6379/1
NOVELCRAFT_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Temporal 工作流 (V2.0 新增)
NOVELCRAFT_TEMPORAL_HOST=localhost:7233

# vLLM 推理服务 (V2.0 新增 - 用于风格迁移)
NOVELCRAFT_VLLM_BASE_URL=http://localhost:8000

# LLM API 配置
NOVELCRAFT_LLM_API_KEY=your-api-key-here
NOVELCRAFT_LLM_BASE_URL=https://api.openai.com/v1
NOVELCRAFT_LLM_MODEL=gpt-4o-mini
NOVELCRAFT_LLM_PLANNER_MODEL=gpt-4o
NOVELCRAFT_LLM_WRITER_MODEL=gpt-4o-mini
NOVELCRAFT_LLM_REVIEWER_MODEL=gpt-4o-mini

# Embedding 模型
NOVELCRAFT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
NOVELCRAFT_EMBEDDING_MODEL_PATH=
NOVELCRAFT_EMBEDDING_DEVICE=cpu

# 应用配置
NOVELCRAFT_SECRET_KEY=your-secret-key-change-in-production
NOVELCRAFT_DEBUG=true
NOVELCRAFT_MAX_REVISION_ROUNDS=3
