# syntax=docker/dockerfile:1
# NovelCraft 后端镜像（生产）
FROM python:3.12-slim

WORKDIR /app

# 系统依赖：build-essential 编译 C 扩展，libpq-dev 给 psycopg2，curl 给健康检查
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl

# 先装依赖，利用 Docker 层缓存 + pip wheel 缓存
COPY backend/requirements.txt ./requirements.txt
# 先装 CPU 版 torch（约 200MB），避免 pip 从 PyPI 拉到 GPU 版（约 2.5GB）
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch torchvision

# 再装其余依赖（sentence-transformers 等会复用已装的 torch）
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -i https://pypi.tuna.tsinghua.edu.cn/simple \
    -r requirements.txt

# 只复制后端源码
COPY backend/ ./backend/

EXPOSE 8000

# 生产模式：不开 --reload
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
